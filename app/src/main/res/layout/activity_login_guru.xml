<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_guru">

    <ImageView
        android:layout_width="205dp"
        android:layout_height="205dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/batik_guru"
        android:translationX="50dp"
        android:translationY="-50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="205dp"
        android:layout_height="205dp"
        android:contentDescription="@null"
        android:rotation="180"
        android:scaleType="centerCrop"
        android:src="@drawable/batik_guru"
        android:translationX="-50dp"
        android:translationY="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/btnBackGuru"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/color_white" />

    <LinearLayout
        android:id="@+id/headerTextGuru"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBackGuru">

        <TextView
            android:id="@+id/tvLoginGuruTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login Guru"
            android:textColor="@color/color_white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoginGuruSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Silahkan login kan akun yang telah Di daftar"
            android:textColor="@color/color_white"
            android:textSize="13sp" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardFormGuru"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerTextGuru">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvLabelNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nama Lengkap"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNamaGuru"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_guru"
                android:hint="Masukkan nama lengkap"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="#222222"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvLabelNip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="NIP"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNipGuru"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_guru"
                android:hint="Masukkan NIP"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:textColor="#222222"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSubmitGuru"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_button_guru"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="@color/color_white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>