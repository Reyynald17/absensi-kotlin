<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white_guru"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_notif_circle_green"
        android:contentDescription="@null"
        android:padding="20dp"
        android:src="@drawable/ic_check"
        app:tint="@color/color_white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Pendaftaran Berhasil"
        android:textColor="@color/color_guru_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Akun Anda sedang menunggu verifikasi dari operator sekolah. Silahkan cek kembali beberapa saat lagi."
        android:textColor="#555555"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnOkPending"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_button_guru"
        android:text="OK"
        android:textAllCaps="false"
        android:textColor="@color/color_white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>