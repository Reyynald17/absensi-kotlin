<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_white">

    <!-- HEADER -->
    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@drawable/bg_header"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnBack"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_kalendar"
                app:tint="@color/color_white" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="kalender"
                android:textColor="@color/color_white"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

    </RelativeLayout>

    <!-- VIEW STATE 1: MONTH GRID SELECTION -->
    <ScrollView
        android:id="@+id/layoutMonthGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="110dp"
        android:background="@drawable/bg_grey_container"
        android:fillViewport="true"
        android:padding="12dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <Button android:id="@+id/btnJanuari" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="JANUARI" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />
            <Button android:id="@+id/btnFebuari" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="FEBUARI" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />
            <Button android:id="@+id/btnMaret" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="MARET" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />
            <Button android:id="@+id/btnApril" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="APRIL" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />
            <Button android:id="@+id/btnMei" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="MEI" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />
            <Button android:id="@+id/btnJuni" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="JUNI" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />
            <Button android:id="@+id/btnJuli" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="JULI" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />
            <Button android:id="@+id/btnAgustus" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="AGUSTUS" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />
            <Button android:id="@+id/btnSeptember" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="SEPTEMBER" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />
            <Button android:id="@+id/btnOktober" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="OKTOBER" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />
            <Button android:id="@+id/btnNovember" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="NOVEMBER" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />
            <Button android:id="@+id/btnDesember" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:backgroundTint="#0088E4" android:text="DESEMBER" android:textColor="@color/color_white" android:textSize="15sp" android:textStyle="bold" app:cornerRadius="18dp" />

        </GridLayout>

    </ScrollView>

    <!-- VIEW STATE 2: MONTHLY CALENDAR DETAIL (MATCH SCREENSHOT 2) -->
    <LinearLayout
        android:id="@+id/layoutCalendarDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="110dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <!-- MAIN CALENDAR CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_blue_card"
            android:orientation="vertical">

            <!-- BRIGHT BLUE MONTH HEADER BAR -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_rounded"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMonthName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Januari"
                        android:textColor="@color/color_white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="2026"
                        android:textColor="@color/color_white"
                        android:textSize="14sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:rotation="180"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/color_white" />

            </RelativeLayout>

            <!-- DAYS OF WEEK ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:orientation="horizontal">

                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Sen" android:textColor="@color/color_white" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Sel" android:textColor="@color/color_white" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Rab" android:textColor="@color/color_white" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Kam" android:textColor="@color/color_white" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Jum" android:textColor="@color/color_white" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Sab" android:textColor="@color/color_white" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Min" android:textColor="@color/color_white" android:textSize="12sp" android:textStyle="bold" />

            </LinearLayout>

            <!-- GRID DAYS RECYCLERVIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCalendarDays"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </LinearLayout>

        <!-- INFORMASI BOX CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dark_blue_card"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- HEADER ROW WITH LEGEND -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvInformasiHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="• Informasi"
                    android:textColor="@color/color_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <!-- RED DOT LIBUR -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_status_alpha_pill" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Libur"
                            android:textColor="@color/color_white"
                            android:textSize="9sp" />

                    </LinearLayout>

                    <Space
                        android:layout_width="14dp"
                        android:layout_height="1dp" />

                    <!-- GREEN DOT UPACARA -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_status_hadir_pill" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Upacara"
                            android:textColor="@color/color_white"
                            android:textSize="9sp" />

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>

            <!-- EVENT LIST TEXT -->
            <LinearLayout
                android:id="@+id/layoutEventList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEvent1Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="#FF1744"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEvent1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tahun baru 2026 masehi"
                    android:textColor="@color/color_white"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvEvent2Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="16"
                    android:textColor="#FF1744"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEvent2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Isra Mi'raj Nabi Muhammad SAW"
                    android:textColor="@color/color_white"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- STUDENT ILLUSTRATIONS -->
    <ImageView
        android:id="@+id/ivStudentLeft"
        android:layout_width="85dp"
        android:layout_height="115dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="55dp"
        android:contentDescription="@null"
        android:elevation="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/siswa_kiri"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivStudentRight"
        android:layout_width="85dp"
        android:layout_height="115dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="55dp"
        android:contentDescription="@null"
        android:elevation="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/siswa_kanan"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTTOM NAVIGATION -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/component_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
