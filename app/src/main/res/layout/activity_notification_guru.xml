<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E8827">

    <FrameLayout
        android:id="@+id/headerNotifGuru"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_guru_rounded"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="90dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:scaleType="fitEnd"
            android:src="@drawable/batik_guru"
            android:translationX="40dp"
            android:translationY="-20dp" />

        <ImageView
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:layout_gravity="bottom|start"
            android:contentDescription="@null"
            android:rotation="180"
            android:scaleType="fitStart"
            android:src="@drawable/batik_guru"
            android:translationX="-40dp"
            android:translationY="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="30dp"
            android:paddingEnd="16dp"
            android:paddingBottom="30dp">

            <ImageView
                android:id="@+id/btnBackNotifGuru"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/color_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="NOTIFICATION"
                android:textColor="@color/color_white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifGuru"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerNotifGuru" />

    <FrameLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="110dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_nav_guru" />

        <ImageView
            android:id="@+id/btnHomeGuru"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="30dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_nav_btn_guru"
            android:contentDescription="@null"
            android:elevation="4dp"
            android:padding="16dp"
            android:src="@drawable/ic_home"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnSearchGuru"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_nav_btn_guru"
            android:contentDescription="@null"
            android:elevation="6dp"
            android:padding="22dp"
            android:src="@drawable/ic_search"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnProfileGuru"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_nav_btn_guru"
            android:contentDescription="@null"
            android:elevation="4dp"
            android:padding="16dp"
            android:src="@drawable/ic_person"
            app:tint="#FFFFFF" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>