<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_white">

    <ImageView
        android:id="@+id/ivBgPattern"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.08"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_pattern"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/headerLayout"
                layout="@layout/component_header" />

            <include
                android:id="@+id/cardKehadiran"
                layout="@layout/component_card_kehadiran" />

            <include
                android:id="@+id/absenHariIni"
                layout="@layout/component_absen_hari_ini" />

            <include
                android:id="@+id/menuGrid"
                layout="@layout/component_menu_grid" />

            <include
                android:id="@+id/quoteLayout"
                layout="@layout/component_quote" />

            <View
                android:layout_width="match_parent"
                android:layout_height="220dp" />

        </LinearLayout>

    </ScrollView>

    <ImageView
        android:id="@+id/ivSiswaKiri"
        android:layout_width="162.5dp"
        android:layout_height="250dp"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@drawable/siswa_kiri"
        android:translationX="-20dp"
        android:translationY="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/ivSiswaKanan"
        android:layout_width="182.5dp"
        android:layout_height="270dp"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@drawable/siswa_kanan"
        android:translationX="20dp"
        android:translationY="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/component_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>