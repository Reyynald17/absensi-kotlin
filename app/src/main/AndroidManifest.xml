<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AbsensiSiswaProto"
        tools:targetApi="31">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AbsensiSiswaProto.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.AbsensiSiswaProto.NoActionBar" />

        <activity
            android:name=".ui.beranda.BerandaActivity"
            android:exported="false"
            android:theme="@style/Theme.AbsensiSiswaProto.NoActionBar" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.AbsensiSiswaProto.NoActionBar" />
        <activity
            android:name=".ui.riwayat.RiwayatActivity"
            android:exported="false"
            android:theme="@style/Theme.AbsensiSiswaProto.NoActionBar" />
        <activity
            android:name=".ui.pelajaran.PelajaranActivity"
            android:exported="false"
            android:theme="@style/Theme.AbsensiSiswaProto.NoActionBar" />
        <activity
            android:name=".ui.kalender.KalenderActivity"
            android:exported="false"
            android:theme="@style/Theme.AbsensiSiswaProto.NoActionBar" />

    </application>

</manifest>